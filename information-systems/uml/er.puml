@startuml
!include common.iuml
hide circle
hide empty members
skinparam nodesep 20
skinparam ranksep 30
skinparam defaultFontSize 16

entity "Управляющая\nорганизация" as UK {
  * ИНН
  --
  название, адрес, телефон
}
entity "Район надзора" as DIS {
  * название
}
entity "Дом" as H {
  * адрес
  --
  год постройки, этажность
}
entity "Квартира" as A {
  * дом + номер
  --
  подъезд, этаж, площадь
}
entity "Пользователь" as U {
  * логин
  --
  ФИО, телефон, e-mail,
  пароль (хэш), роль, активен
}
entity "Житель" as R
entity "Сотрудник УК" as S {
  должность
}
entity "Инспектор ГЖИ" as I {
  * служебный номер
}
entity "Специализация" as SP {
  * название
}
entity "Категория\nобращения" as C {
  * название
  --
  норматив (ч), аварийная
}
entity "Обращение" as Q {
  * номер
  --
  описание, результат,
  создано, крайний срок,
  просрочено
}
entity "Статус обращения\n(журнал)" as HI {
  статус, время установки
  (время выполнения = время
  записи DONE, время закрытия =
  время записи CLOSED/CANCELLED),
  комментарий
}
entity "Комментарий" as CM {
  текст, время
}
entity "Оценка" as RT {
  балл 1–5, отзыв
}
entity "Вложение" as AT {
  * путь хранения
  --
  имя, тип, размер
}
entity "Жалоба в ГЖИ" as CP {
  текст, статус, решение
}
entity "Предписание" as O {
  * номер
  --
  нарушение, срок, статус,
  отчёт УК, итог проверки
}
entity "Объявление" as AN {
  заголовок, текст,
  период показа
}
entity "Прибор учёта" as M {
  * ресурс + зав. номер
  --
  поверка до, активен
}
entity "Показание" as MR {
  * прибор + дата
  --
  значение
}
entity "Уведомление" as N {
  событие, объект, прочитано
}

UK ||--o{ H : обслуживает
DIS ||--o{ H : включает
H ||--|{ A : состоит из
A ||--o{ M : оснащена
M ||--o{ MR : имеет

U ||--o| R : является
U ||--o| S : является
U ||--o| I : является
R }o--o{ A : "проживает\n(M:N)"
S }o--|| UK : работает в
S }o--o{ SP : "владеет\n(M:N)"
I }o--|| DIS : курирует
SP ||--o{ C : требуется для

R ||--o{ Q : создаёт
Q }o--|| H : по дому
Q }o--o| A : по квартире
Q }o--|| C : относится к
S |o--o{ Q : исполняет
Q ||--|{ HI : журнал
Q ||--o{ CM : переписка
Q |o--o{ Q : "повторяет\n(взамен отклонённого)"
U ||--o{ CM : пишет
Q ||--o| RT : оценивается
Q ||--o{ AT : вложения
CM ||--o{ AT
R ||--o{ CP : подаёт
Q ||--o| CP : основание
I ||--o{ O : выдаёт
O }o--|| UK : адресовано
O }o--o{ Q : "касается\n(M:N)"
CP }o--o| O : учтена в
O ||--o{ AT
UK ||--o{ AN : публикует
AN }o--o{ H : "адресовано\n(M:N)"
U ||--o{ N : получает
@enduml
